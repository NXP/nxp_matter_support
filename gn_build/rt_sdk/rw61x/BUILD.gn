import("//build_overrides/nxp_sdk.gni")

#allows to get common NXP SDK gn options
import("${nxp_sdk_build_root}/nxp_sdk.gni")

# Allows to get various RT gn options
import("${nxp_sdk_build_root}/${nxp_sdk_name}/${nxp_sdk_name}.gni")

import(
    "${nxp_sdk_build_root}/${nxp_sdk_name}/${rt_platform}/${rt_platform}.gni")

#allows to get common NXP SDK gn options
import("${nxp_sdk_build_root}/nxp_sdk.gni")

import("${nxp_sdk_build_root}/mbedtls/mbedtls.gni")
rt_mbedtls_root = "${nxp_sdk_root}/middleware/mbedtls3x"

_psa_driver_root = "${nxp_sdk_root}/components/psa_crypto_driver"
_els_pkc_root = "${nxp_sdk_root}/components/els_pkc"

config("mbedtls_els_pkc_config") {
  include_dirs = [
    # PSA crypto driver top-level (els_pkc_driver.h lives here)
    "${_psa_driver_root}/els_pkc",
    # PSA crypto driver includes
    "${_psa_driver_root}/els_pkc/include/common",
    "${_psa_driver_root}/els_pkc/include/transparent",
    "${_psa_driver_root}/els_pkc/include/opaque",
    "${_psa_driver_root}/els_pkc/oracle/inc",
    "${_psa_driver_root}/els_pkc/oracle/platforms/rw61x",
    "${_psa_driver_root}/osal",
    "${_psa_driver_root}/osal/frtos",
    # els_pkc component includes
    "${_els_pkc_root}",
    "${_els_pkc_root}/includes/platform/rw61x",
    "${_els_pkc_root}/src/compiler",
    "${_els_pkc_root}/src/inc",
    "${_els_pkc_root}/src/platforms/rw61x",
    "${_els_pkc_root}/src/platforms/rw61x/inc",
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/inc",
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/inc/internal",
    # mbedtls3x port directory (hw_init, rng, psa_its headers)
    "${rt_mbedtls_root}/port",
    # GN build config directory
    "${nxp_sdk_build_root}/mbedtls/config",
    # secure_storage ITS include dirs (provides psa/internal_trusted_storage.h)
    "${nxp_sdk_root}/middleware/secure_storage/include",
    "${nxp_sdk_root}/middleware/secure_storage/zephyr/subsys/secure_storage/include",
    "${nxp_sdk_root}/middleware/secure_storage/zephyr/subsys/secure_storage/include/internal",
  ]
  defines = [
    "MBEDTLS_CONFIG_FILE=<nxp_matter_mbedtls_config.h>",
    "MBEDTLS_PSA_CRYPTO_CONFIG_FILE=<rw61x_matter_mbedtls_config.h>",
    # Required by psa_crypto_driver/osal/threading_alt.h to select MbedTLS 3.x path
    "CONFIG_USING_MBEDTLS_3X=1",
    # Use TRNG path in mcux_psa_els_pkc_entropy.c (avoids ELS PRNG macros)
    "MBEDTLS_MCUX_USE_TRNG_AS_ENTROPY_SEED=1",
    # Enable ELS PKC API in mbedtls port
    "MBEDTLS_MCUX_ELS_PKC_API=1",
    # PSA threading driver enable
    "PSA_CRYPTO_DRIVER_THREAD_EN=1",
    "PSA_CRYPTO_DRIVER_ELS_PKC=1",
  ]

  # The secure whole factory data path (ELSFactoryData.c) uses the ELS blob
  # host helpers (host_wrap_key/host_derive_key/host_perform_key_agreement),
  # which pull in the mbedtls software NIST_KW/CMAC/ECDH modules. Those modules
  # are only compiled into the mbedtls port when this macro is defined, so
  # enable it when the feature is on to avoid undefined references.
  if (nxp_enable_secure_whole_factory_data) {
    defines += [ "CONFIG_NXP_FACTORY_DAC_BLOB_GENERATION=1" ]
  }
}

mbedtls_target("nxp_els_pkc_mbedtls") {
  sources = []
  public_configs = [ ":mbedtls_els_pkc_config" ]
  public_deps = [ nxp_sdk_driver_target ]
  sources += [
    # PSA crypto driver - oracle
    "${_psa_driver_root}/els_pkc/oracle/src/mcuxClPsaDriver_Oracle.c",
    "${_psa_driver_root}/els_pkc/oracle/src/mcuxClPsaDriver_Oracle_ElsUtils.c",
    "${_psa_driver_root}/els_pkc/oracle/src/mcuxClPsaDriver_Oracle_Utils.c",

    # PSA crypto driver - common
    "${_psa_driver_root}/els_pkc/src/common/mcux_psa_els_pkc_common_init.c",
    "${_psa_driver_root}/els_pkc/src/common/mcux_psa_els_pkc_entropy.c",

    # PSA crypto driver - opaque
    "${_psa_driver_root}/els_pkc/src/opaque/mcux_psa_els_pkc_opaque_aead.c",
    "${_psa_driver_root}/els_pkc/src/opaque/mcux_psa_els_pkc_opaque_asymmetric_signature.c",
    "${_psa_driver_root}/els_pkc/src/opaque/mcux_psa_els_pkc_opaque_cipher.c",
    "${_psa_driver_root}/els_pkc/src/opaque/mcux_psa_els_pkc_opaque_init.c",
    "${_psa_driver_root}/els_pkc/src/opaque/mcux_psa_els_pkc_opaque_key_generation.c",
    "${_psa_driver_root}/els_pkc/src/opaque/mcux_psa_els_pkc_opaque_mac.c",

    # PSA crypto driver - transparent
    "${_psa_driver_root}/els_pkc/src/transparent/mcux_psa_els_pkc_aead.c",
    "${_psa_driver_root}/els_pkc/src/transparent/mcux_psa_els_pkc_asymmetric_signature.c",
    "${_psa_driver_root}/els_pkc/src/transparent/mcux_psa_els_pkc_cipher.c",
    "${_psa_driver_root}/els_pkc/src/transparent/mcux_psa_els_pkc_hash.c",
    "${_psa_driver_root}/els_pkc/src/transparent/mcux_psa_els_pkc_init.c",
    "${_psa_driver_root}/els_pkc/src/transparent/mcux_psa_els_pkc_key_generation.c",
    "${_psa_driver_root}/els_pkc/src/transparent/mcux_psa_els_pkc_mac.c",

    # PSA crypto driver - OSAL (FreeRTOS threading)
    "${_psa_driver_root}/osal/frtos/osal_mutex.c",
    "${_psa_driver_root}/osal/frtos/threading_alt.c",

    # mcuxClPsaDriver internal implementation files
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/src/mcuxClPsaDriver_Aead.c",
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/src/mcuxClPsaDriver_Cipher.c",
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/src/mcuxClPsaDriver_DER_functions.c",
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/src/mcuxClPsaDriver_export_public_key.c",
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/src/mcuxClPsaDriver_generate_ecp_key.c",
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/src/mcuxClPsaDriver_Hash.c",
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/src/mcuxClPsaDriver_Key.c",
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/src/mcuxClPsaDriver_Mac.c",
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/src/mcuxClPsaDriver_Rsa.c",
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/src/mcuxClPsaDriver_Sign.c",
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/src/mcuxClPsaDriver_UpdateKeyStatus.c",
    "${_els_pkc_root}/src/comps/mcuxClPsaDriver/src/mcuxClPsaDriver_Verify.c",
  ]

  # els_pkc SDK hook: provides ELS EdgeLock key/AES helpers
  # (els_enable, ELS_Cipher_Aes_Ecb, import_die_int_wrapped_key_into_els,
  # import_plain_key_into_els, export_key_from_els, els_delete_key) used by the
  # secure whole factory data path. Only needed when that feature is enabled,
  # so gate it to avoid pulling ELS symbols into the pure PSA crypto build.
  if (nxp_enable_secure_whole_factory_data) {
    sources += [
      "${nxp_sdk_build_root}/${nxp_sdk_name}/sdk_hook/els_pkc/ELSFactoryData.c",
    ]
  }
  if (chip_enable_thread) {
    public_deps += [ "${openthread_root}/src/core:libopenthread_core_headers" ]
  }
}

group("nxp_sdk_mbedtls_config") {
  public_configs = [ ":mbedtls_els_pkc_config" ]
}

group("nxp_mbedtls") {
  public_deps = [ ":nxp_els_pkc_mbedtls" ]
}

source_set("nxp_sdk_mbedtls_dep") {
  # Add here SDK source files which have a dependency on mbedtls
  # this approach helps avoid circular dependencies between mbedtls and rw61x_sdk_drivers targets

  sources = [
    "${nxp_sdk_root}/middleware/secure_storage/src/its/implementation_store.c",
    "${nxp_sdk_root}/middleware/secure_storage/src/its/store/nvs_its.c",
  ]

  include_dirs = [
    "${nxp_sdk_root}/middleware/secure_storage/include",
    "${nxp_sdk_root}/middleware/secure_storage/zephyr/subsys/secure_storage/include",
    "${nxp_sdk_root}/middleware/secure_storage/zephyr/subsys/secure_storage/include/internal",
  ]

  defines = [
    "SECURE_STORAGE",
    "SECURE_STORAGE_ITS_IMPLEMENTATION_WITH_ONLY_STORE",
    "SECURE_STORAGE_ITS_STORE_IMPLEMENTATION_NVS",
    "CONFIG_SECURE_STORAGE_ITS_MAX_DATA_SIZE=1024",
    "CONFIG_SECURE_STORAGE_ITS_STORE_SETTINGS_PREFIX=\"its/\"",
    "CONFIG_SECURE_STORAGE_ITS_STORE_SETTINGS_NAME_MAX_LEN=14",
  ]

  deps = [
    "${nxp_sdk_build_root}/${nxp_sdk_name}/${rt_platform}:nxp_mbedtls",
    "${nxp_sdk_build_root}/${nxp_sdk_name}/${rt_platform}:nxp_sdk_mbedtls_config",
    nxp_sdk_driver_target,
  ]
}

group("nxp_sdk") {
  # Add SDK's source set which depends on mbedtls
  public_deps = [ ":nxp_sdk_mbedtls_dep" ]
}
